[Unit]
Description=docs.llmops.ru

Requires=docker.service
After=docker.service

[Service]

Restart=always
TimeoutStartSec=0
ExecStartPre=-/usr/bin/docker kill docs.llmops.ru
ExecStartPre=-/usr/bin/docker rm docs.llmops.ru
ExecStartPre=-/usr/bin/docker pull marley/docs.llmops.ru:latest
ExecStart=/bin/sh -c '/usr/bin/docker run --name docs.llmops.ru   \
 -p 4006:80                        \
 marley/docs.llmops.ru'
ExecStop=-/usr/bin/docker kill docs.llmops.ru
ExecStop=-/usr/bin/docker rm docs.llmops.ru

[Install]
WantedBy=multi-user.target
